# Postgres (compose.yaml)
KOBO_DB_USER=kobo
KOBO_DB_PASSWORD=kobo
KOBO_DB_NAME=kobo
KOBO_DB_PORT=5433

# kobo
KOBO_DATABASE_URL=postgres://kobo:kobo@127.0.0.1:5433/kobo?sslmode=disable
KOBO_LISTEN=127.0.0.1:8787
# Directory that holds the target repositories (one directory per project)
KOBO_PROJECTS_DIR=/home/you/programF
# Where task worktrees are created
KOBO_WORKTREES_DIR=/home/you/.kobo/worktrees
# off_peak window, local time, HH:MM-HH:MM (may wrap past midnight)
KOBO_OFF_PEAK=01:00-07:00
KOBO_MAX_REVIEW_ROUNDS=2
KOBO_DEV_TIMEOUT=60m
KOBO_REVIEW_TIMEOUT=30m
# Required. owner/name of the private repository that holds PR screenshots
KOBO_SHOTS_REPO=Satoru314/kobo-shots
